{
  "name": "cookbook-canary",
  "version": "0.1.0",
  "description": "Proves every example in a repo still runs — each on its own hardware-isolated microVM.",
  "keywords": ["solari", "microvm", "sandbox", "examples", "ci", "documentation-testing"],
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "bin": { "canary": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "canary": "node src/cli.ts"
  },
  "peerDependencies": {
    "@solarisdk/browser": ">=0.1.0",
    "@solarisdk/desktop": ">=0.1.0",
    "@solarisdk/sandbox": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@solarisdk/browser": { "optional": true },
    "@solarisdk/desktop": { "optional": true },
    "@solarisdk/sandbox": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
